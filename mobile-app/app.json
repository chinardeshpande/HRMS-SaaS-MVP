{
  "expo": {
    "name": "AuroraHR Mobile",
    "slug": "hrms-saas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
